# Preview is deliberately noindex. Production mode alone does not enable indexing.
SITE_STAGE=preview
# Set only the approved canonical public HTTPS origin; no invented fallback.
# SITE_ORIGIN=https://your-approved-domain
FESTIVAL_FACTS_APPROVED=false
ANNOUNCEMENT_INSTANT_APPROVED=false
# Public release remains code-gated until operational signup + approved privacy are verified.

# Server-only. Supply the real URI through a local untracked .env.local or a
# deployment Secret reference; never use NEXT_PUBLIC_ or commit credentials.
MONGODB_URI=
# Exact browser-facing origin (no path/trailing slash). Set explicitly behind
# ingress/proxies; otherwise the API compares Origin to the request URL origin.
# SIGNUP_ALLOWED_ORIGIN=https://your-approved-domain
